{
  "schemaVersion": 1,
  "id": "reinfcore",
  "version": "${version}",
  "name": "Reinforced Core 26.2 Compatibility Port",
  "description": "Compatibility-first 26.2 port of Aton-Kish Reinforced Core.",
  "authors": [
    "Aton-Kish",
    "26.2 compatibility port"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "atonkish.reinfcore.ReinforcedCoreMod"
    ],
    "client": [
      "atonkish.reinfcore.ReinforcedCoreClientMod"
    ],
    "modmenu": [
      "atonkish.reinfcore.integration.modmenu.ModMenu"
    ]
  },
  "mixins": [
    "reinfcore.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
